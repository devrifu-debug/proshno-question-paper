{
  "rewrites": [
    { "source": "/auth-config.js", "destination": "/api/handler?route=auth-config" },
    { "source": "/checker/auth-config.js", "destination": "/api/handler?route=auth-config" },
    { "source": "/api/:path*", "destination": "/api/handler?route=:path*" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/checker/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
